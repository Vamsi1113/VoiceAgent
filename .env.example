# ── LLM ───────────────────────────────────────────────────────────────────────
# Which provider to use: anthropic | openai-compat
LLM_PROVIDER=anthropic

# Anthropic Claude API key (never commit a real value)
ANTHROPIC_API_KEY=

# OpenAI-compatible alternative (e.g. Ollama running locally)
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=

# ── Speech / TTS Provider ─────────────────────────────────────────────────────
# Options: "voicestudio" (local VoiceStudio TTS) | "none"
TTS_PROVIDER=voicestudio

# ── VoiceStudio (local, loopback - no key needed unless remote) ───────────────
VOICESTUDIO_BASE_URL=http://localhost:3900
OMNIVOICE_API_KEY=

# Voice profile ID to use for TTS (get from GET /v1/audio/voices)
VOICE_ID=alloy

# ── Gateway ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=127.0.0.1

# JWT signing secret - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/companion.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── MCP ───────────────────────────────────────────────────────────────────────
# MCP requires auth before exposing publicly. Set to 1 only after OAuth is configured.
MCP_AUTH_ENABLED=0

